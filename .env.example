# Application
APP_NAME="Strategic Navigator"
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
TIME_ZONE=Europe/Moscow

# Корп-прокси для парсинга сайтов и Telegram
HTTP_PROXY=http://ar-proxy.severstal.severstalgroup.com:3128
HTTPS_PROXY=http://ar-proxy.severstal.severstalgroup.com:3128
PARSING_PROXY=http://ar-proxy.severstal.severstalgroup.com:3128
NO_PROXY=localhost,127.0.0.1,.severstal.severstalgroup.com,.severstalgroup.com,sso-id-test-int.severstal.com
# TELEGRAM_PROXY=  # опционально; иначе используется HTTP_PROXY

# RAG: Postgres + pgvector (DATABASE_URL — секрет в Vault)
# DATABASE_URL=postgresql://navigator:navigator@postgres:5432/strategic_navigator
# SAVE_NEWS_TO_DB=true
# Qdrant не используем в контуре; если задать QDRANT_URL, он перебьёт Postgres.
# QDRANT_URL=
# QDRANT_API_KEY=

# LLM / embeddings (секрет в Vault)
OPENROUTER_API_KEY=
BRIEF_MODEL=google/gemini-3.6-flash
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# BRIEF_MAP_CONCURRENCY=3
# WEB_MAX_CONCURRENT_JOBS=4

# Сессии веб-API
AUTH_SECRET=

# Корпоративный вход (public client, Authorization Code + PKCE; client secret не нужен)
AUTH_PROVIDER=keycloak
KEYCLOAK_URL=https://sso-id-test-int.severstal.com
KEYCLOAK_REALM=common
KEYCLOAK_CLIENT_ID=strategic_navigator
# Внешний HTTPS-адрес frontend целевого окружения
KEYCLOAK_PUBLIC_URL=https://frontend-dev.sss-ti.kube.severstal.severstalgroup.com
KEYCLOAK_ADMIN_ROLE=Strategic-Navigator_Admins
KEYCLOAK_USER_ROLE=Strategic-Navigator_Users_Test
# Файл доверенных CA внутри контейнера backend
KEYCLOAK_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# Передача сессионных cookie только по HTTPS
AUTH_COOKIE_SECURE=true

# OpenTelemetry (optional)
OTEL_SERVICE_NAME=strategic-navigator-backend
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_EXPORTER=none
OTEL_SDK_DISABLED=true
