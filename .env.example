# Application
APP_NAME="Strategic Navigator"
APP_VERSION=1.0.0
DEBUG=false
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
TIME_ZONE=Europe/Moscow

# Корп-прокси для парсинга сайтов и Telegram
HTTP_PROXY=http://ar-proxy.severstal.severstalgroup.com:3128
HTTPS_PROXY=http://ar-proxy.severstal.severstalgroup.com:3128
PARSING_PROXY=http://ar-proxy.severstal.severstalgroup.com:3128
NO_PROXY=localhost,127.0.0.1,.severstal.severstalgroup.com,.severstalgroup.com
# TELEGRAM_PROXY=  # опционально; иначе используется HTTP_PROXY

# Postgres + pgvector — так же, как в исходном проекте. Секрет в Vault.
# DATABASE_URL=postgresql://USER:PASSWORD@pg-cdb-tst09:5432/strategic_navigator_test
# SAVE_NEWS_TO_DB=true

# Qdrant в проде не используется. Включать только если явно нужен другой векторный стор.
# QDRANT_URL=
# QDRANT_API_KEY=

# LLM / embeddings (секрет в Vault)
OPENROUTER_API_KEY=
BRIEF_MODEL=google/gemini-3.6-flash
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# BRIEF_MAP_CONCURRENCY=3
# WEB_MAX_CONCURRENT_JOBS=4

# Сессии веб-API
AUTH_SECRET=

# S3-бакеты (ключи только в Vault, сюда не писать)
# Эндпоинт запросите у тех, кто выдал бакеты — в письме с ключами его не было.
# S3_ENDPOINT=https://<s3-endpoint>
# S3_REGION=us-east-1
# S3_ADDRESSING_STYLE=path
# S3_FILES_BUCKET=strategic-navigator-files-test
# S3_FILES_ACCESS_KEY=
# S3_FILES_SECRET_KEY=
# S3_ARCHIVE_BUCKET=strategic-navigator-archive-test
# S3_ARCHIVE_ACCESS_KEY=
# S3_ARCHIVE_SECRET_KEY=
# NEWS_ARCHIVE_AFTER_DAYS=365

# OpenTelemetry (optional)
OTEL_SERVICE_NAME=strategic-navigator-backend
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_TRACES_EXPORTER=none
OTEL_SDK_DISABLED=true
